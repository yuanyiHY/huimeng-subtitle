# ==============================================================================
# 绘梦subtitle —— 云端密钥示例
#
# 用法：cp .env.example .env  然后填入你自己的 Key
# 说明：三个模型槽位各管一摊，互相独立，可以指向不同的服务商
#       纯本地模式（本地 whisper 转写 + 本地翻译）可以全部留空
# ==============================================================================

# ------------------------------------------------------------------ 专用翻译模型
# 负责：文件转写的翻译、本地录音模式的翻译
# 推荐：阿里云百炼 qwen-mt-lite（便宜且质量好）
#       https://dashscope.aliyuncs.com/compatible-mode/v1
MT_BASE_URL=
MT_API_KEY=
MT_MODEL=

# 翻译引擎：cloud（云端）/ local（本地 CT2 模型）/ auto（自动选择）
MT_ENGINE=auto

# 思考强度：off（关闭）/ 留空（默认）/ deep（深度）
# 翻译任务不需要思考，保持 off 即可，否则又慢又贵
MT_THINKING=off


# ------------------------------------------------------------------ 深度思考模型
# 负责：会议整理、随堂笔记等后台深度整理
# 推荐：deepseek-chat、glm 系列等，思考强度建议 deep
MAIN_BASE_URL=
MAIN_API_KEY=
MAIN_MODEL=
MAIN_THINKING=deep


# ------------------------------------------------------------------ 轻量实时模型
# 负责：录音过程中的实时重点提炼（每几秒调用一次）
# 要求：一定要快。思考强度必须是 off，否则实时性会明显变差
LIGHT_BASE_URL=
LIGHT_API_KEY=
LIGHT_MODEL=
LIGHT_THINKING=off


# ------------------------------------------------------------------ 实时同传模型
# 打开「实时同传模式」时使用，走阿里云百炼专用 WebSocket 接口，
# 复用上面的 MT_API_KEY（因此该 Key 必须是百炼的，不能是别的服务商）
#
# 可选值（两者同价，3.8 标点与大小写更规范）：
#   qwen3.5-livetranslate-flash-realtime
#   qwen3.8-livetranslate-flash-realtime
#
# 留空则用程序内置默认值
LIVETRANSLATE_MODEL=qwen3.5-livetranslate-flash-realtime


# ------------------------------------------------------------------ 存储位置（可选）
# 留空则使用默认路径：
#   录音   ~/Documents/intrealtimetranslate-recordings
#   归档   ~/Library/Application Support/intrealtimetranslate/archives
# RECORDINGS_DIR=~/Documents/intrealtimetranslate-recordings
# ARCHIVES_DIR=~/Library/Application Support/intrealtimetranslate/archives
